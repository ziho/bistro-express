# Bistro Express — `npm run setup` copies this to .env (never commit .env).
# All values below are placeholders.

PUBLIC_BASE_URL=https://share.example.com/bistro
ADMIN_BASE_URL=https://admin-host.example.ts.net:8788/bistro

# Generated by `npm run setup` — salted scrypt hash for the public date gate.
ENTRY_DATE_HASH=
# Admin access is passwordless on the private Tailscale listener.

# Only set to false for http://localhost development.
COOKIE_SECURE=true
# Trust X-Forwarded-For from the reverse proxy for rate-limit keys.
TRUST_PROXY=true

# Container user — setup writes your host uid/gid so ./data stays writable.
APP_UID=1000
APP_GID=1000
